# Keep the build context small and the image free of data, weights and caches.
.git
data/
*.pt
*.pth
*.ckpt
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
.env
.env.*
.DS_Store
# The deck is not needed to run the code or the tests. reports/figures/ and .github/ ARE kept: the tests read them
# (every figure named in docs/PROVENANCE.md must exist, and the repository-file tests read .github/).
presentation/
